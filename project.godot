; Terrain demo - generated height map + bird's-eye third-person controller.

config_version=5

[application]

config/name="Terrain Demo"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":87,"physical_keycode":0,"pressed":true),Object(InputEventKey,"keycode":4194320,"physical_keycode":0,"pressed":true)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":83,"physical_keycode":0,"pressed":true),Object(InputEventKey,"keycode":4194322,"physical_keycode":0,"pressed":true)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":65,"physical_keycode":0,"pressed":true),Object(InputEventKey,"keycode":4194319,"physical_keycode":0,"pressed":true)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":68,"physical_keycode":0,"pressed":true),Object(InputEventKey,"keycode":4194321,"physical_keycode":0,"pressed":true)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":32,"physical_keycode":0,"pressed":true)]
}
cam_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":81,"physical_keycode":0,"pressed":true)]
}
cam_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":69,"physical_keycode":0,"pressed":true)]
}

[rendering]

; Mobile renderer: works on iPad (Xogot) and is plenty for this scene.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2

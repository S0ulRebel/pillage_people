; Terrain demo - generated height map + bird's-eye third-person controller.

config_version=5

[application]

config/name="Terrain Demo"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
; scale the whole picture (and the touch UI) to whatever screen it runs on
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":87,"physical_keycode":0,"pressed":true),Object(InputEventKey,"keycode":4194320,"physical_keycode":0,"pressed":true)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":83,"physical_keycode":0,"pressed":true),Object(InputEventKey,"keycode":4194322,"physical_keycode":0,"pressed":true)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":65,"physical_keycode":0,"pressed":true),Object(InputEventKey,"keycode":4194319,"physical_keycode":0,"pressed":true)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":68,"physical_keycode":0,"pressed":true),Object(InputEventKey,"keycode":4194321,"physical_keycode":0,"pressed":true)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":32,"physical_keycode":0,"pressed":true)]
}
dive={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194325,"physical_keycode":0,"pressed":true),Object(InputEventKey,"keycode":67,"physical_keycode":0,"pressed":true)]
}
cam_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":81,"physical_keycode":0,"pressed":true)]
}
cam_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":69,"physical_keycode":0,"pressed":true)]
}
cam_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":82,"physical_keycode":0,"pressed":true)]
}
cam_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":70,"physical_keycode":0,"pressed":true)]
}


[input_devices]

; lets the touch controls be tested with a mouse on desktop
pointing/emulate_touch_from_mouse=true

[physics]

; Jolt handles HeightMapShape3D holes (NaN samples) cleanly - the default engine works but
; floods the log with normalization warnings. Holes are how tunnels/pits will be carved.
3d/physics_engine="Jolt Physics"

[rendering]

; Mobile renderer: works on iPad (Xogot) and is plenty for this scene.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=3
